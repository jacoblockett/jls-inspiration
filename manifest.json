{
  "name": "inspiration",
  "version": "0.0.0",
  "min_installer": "0.4.1",
  "description": "Audited multi-source research for visual design and product/UX direction",
  "skill_files": [
    "SKILL.md"
  ],
  "harness_resources": {
    "codex": {
      "agents": [
        "agents/codex/inspiration-brief.toml",
        "agents/codex/inspiration-visual-researcher.toml",
        "agents/codex/inspiration-visual-auditor.toml",
        "agents/codex/inspiration-product-researcher.toml",
        "agents/codex/inspiration-product-auditor.toml",
        "agents/codex/inspiration-synthesizer.toml"
      ]
    },
    "claude": {
      "agents": [
        "agents/claude/inspiration-brief.md",
        "agents/claude/inspiration-visual-researcher.md",
        "agents/claude/inspiration-visual-auditor.md",
        "agents/claude/inspiration-product-researcher.md",
        "agents/claude/inspiration-product-auditor.md",
        "agents/claude/inspiration-synthesizer.md"
      ]
    }
  },
  "instruction_fragment": "AGENTS.md",
  "generated_data": [
    {
      "path": ".inspiration",
      "marker": "project.json",
      "description": "Inspiration research history, captured evidence, working packets, and synthesized report"
    }
  ],
  "tools": {
    "history": {
      "artifacts": {
        "windows-x64": "bin/history.exe",
        "windows-arm64": "bin/history.exe",
        "macos-x64": "bin/history",
        "macos-arm64": "bin/history",
        "linux-x64-gnu": "bin/history",
        "linux-arm64-gnu": "bin/history",
        "linux-x64-musl": "bin/history",
        "linux-arm64-musl": "bin/history"
      },
      "token": "HISTORY_CLI"
    },
    "screenshot": {
      "artifacts": {
        "windows-x64": "bin/screenshot.exe",
        "windows-arm64": "bin/screenshot.exe",
        "macos-x64": "bin/screenshot",
        "macos-arm64": "bin/screenshot",
        "linux-x64-gnu": "bin/screenshot",
        "linux-arm64-gnu": "bin/screenshot",
        "linux-x64-musl": "bin/screenshot",
        "linux-arm64-musl": "bin/screenshot"
      },
      "token": "SCREENSHOT_CLI"
    }
  }
}
